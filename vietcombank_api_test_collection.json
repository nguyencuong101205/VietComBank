            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Đăng nhập Bước 1 thành công - Mã 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.tempToken) {",
                  "    pm.collectionVariables.set('temp_token', jsonData.data.tempToken);",
                  "    pm.collectionVariables.set('dev_otp', jsonData.data.devOtp);",
                  "    console.log('Đã lưu tempToken và devOtp Admin: ' + jsonData.data.devOtp);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin_super\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
